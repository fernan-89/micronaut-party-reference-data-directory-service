{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
    "name": "Company Service - Comprehensive Lifecycle & Telemetry Suite",
    "description": "Enterprise-grade E2E Postman Suite for the Party Reference Data Directory Service Domain (BIAN-aligned, ADR-013/014/015). Covers the complete Organisation lifecycle under /party-reference-data-directory/v1 (initiate, retrieve, update, control/activate|suspend|cancel), the promoted OrganisationUnit subordinate resource (own ACTIVE/SUSPENDED lifecycle), contact capture, mandatory X-Executor auditing, RFC 7807 error_code assertions, and automated W3C distributed traceparent correlation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "39879181"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically generate standard W3C traceparent (ADR-010) and X-Trace-Id",
          "function generateHex(len) {",
          "    let result = '';",
          "    const chars = '0123456789abcdef';",
          "    for (let i = 0; i < len; i++) {",
          "        result += chars.charAt(Math.floor(Math.random() * chars.length));",
          "    }",
          "    return result;",
          "}",
          "const traceId = generateHex(32);",
          "const spanId = generateHex(16);",
          "const traceparent = `00-${traceId}-${spanId}-01`;",
          "pm.request.headers.upsert({ key: 'traceparent', value: traceparent });",
          "pm.request.headers.upsert({ key: 'X-Trace-Id', value: traceId });",
          "pm.environment.set('currentTraceId', traceId);"
        ]
      }
    }
  ],
